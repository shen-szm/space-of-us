{
  "name": "space-of-us",
  "version": "0.1.1",
  "description": "A private couple space for memories, promises, favorites, and shared plans.",
  "author": "Space of us",
  "private": false,
  "scripts": {
    "dev": "next dev -p 3002",
    "dev:keepalive": "bash scripts/dev-keepalive.sh",
    "dev:daemon": "bash scripts/start-dev-daemon.sh",
    "build": "next build",
    "desktop:prepare": "npm run build && node scripts/prepare-standalone.mjs",
    "start:production": "node scripts/start-production.mjs",
    "preview": "next start",
    "start": "next start",
    "test": "node --no-warnings --test tests/auth-session-info.test.mts tests/admin-inbox-loading.test.mts tests/auth-security.test.mts tests/security-config.test.mts tests/theme-settings.test.mts",
    "lint": "eslint",
    "check:production-mail": "node scripts/check-production-mail.mjs",
    "verify:production-env": "node scripts/verify-production-env-loader.mjs",
    "verify:standalone-assets": "node scripts/verify-start-production-assets.mjs",
    "desktop": "electron electron/main.js",
    "dist:dir": "npm run desktop:prepare && electron-builder --dir",
    "dist:mac": "npm run desktop:prepare && electron-builder --mac dmg",
    "dist:win": "npm run desktop:prepare && electron-builder --win nsis --x64"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.spaceofus.desktop",
    "productName": "Space of us",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "npmRebuild": false,
    "files": [
      "!node_modules/**/*",
      "electron/**/*",
      ".next/standalone/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.lifestyle",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-${arch}-Setup.${ext}"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.0",
    "d3-geo": "^3.1.1",
    "framer-motion": "^12.39.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
